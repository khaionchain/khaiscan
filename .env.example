# === Telegram ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram user ID — only this user can run scans
# Get it by messaging @userinfobot on Telegram
OWNER_ID=123456789

# === AI ===
# Google AI Studio API key (free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === Blockchain Data ===
# Helius free tier: https://dashboard.helius.dev/
HELIUS_API_KEY=your_helius_api_key_here

# === Webhook (for production VPS deployment) ===
# Full public HTTPS URL where your bot is hosted, e.g. https://yourdomain.com
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_SECRET=a_random_secret_string_for_webhook_verification

# Port the aiohttp server listens on
PORT=8080
